APP_NAME="Heaven Gate Camp"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Cairo
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL 8 recommended in production (row locks protect against double bookings).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=heavengate
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="reservations@heavengatecamp.com"
MAIL_FROM_NAME="Heaven Gate Camp"

# ---- Heaven Gate ----
HG_CURRENCY=EGP
HG_HOLD_MINUTES=20
HG_ADMIN_EMAIL=reservations@heavengatecamp.com
HG_WHATSAPP=
HG_INSTAGRAM=https://www.instagram.com/heavengatecamp/

# ---- EasyKash (https://www.easykash.net) ----
EASYKASH_ENABLED=true
EASYKASH_BASE_URL=https://back.easykash.net
EASYKASH_API_KEY=
EASYKASH_HMAC_SECRET=
# Comma-separated EasyKash payment option ids enabled on your merchant account
# (e.g. card, Fawry, wallets). Leave empty to let EasyKash show all.
EASYKASH_PAYMENT_OPTIONS=
EASYKASH_CASH_EXPIRY_HOURS=12

# Admin account created by the seeder
ADMIN_NAME="Heaven Gate Admin"
ADMIN_EMAIL=admin@heavengatecamp.com
ADMIN_PASSWORD=change-me-now
